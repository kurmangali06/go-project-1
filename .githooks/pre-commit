#!/bin/sh
# Гоняется перед каждым git commit. Пропустить: git commit --no-verify
#
# Хук лежит в репозитории (а не в .git/hooks, который не версионируется),
# поэтому его надо один раз подключить: make hooks
set -e

echo "pre-commit: gofmt"
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
	echo "не отформатировано, исправь через gofmt -w:"
	echo "$unformatted"
	exit 1
fi

echo "pre-commit: go vet"
go vet ./...

echo "pre-commit: go test -race"
go test -race -count=1 ./...

echo "pre-commit: ок"